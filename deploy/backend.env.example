# Production environment for reflow-backend.service — TEMPLATE.
# deploy/install.sh copies this to /etc/reflow-oven/backend.env (root:root, mode 600) and replaces
# every CHANGE_ME with a strong random value. NEVER commit the real file; never reuse dev values.
#
# The Program.cs fail-fasts refuse to boot in Production while Jwt__SigningKey / *__Password still
# carry the dev placeholders — this file is how they get real values (audit BE-3).

ASPNETCORE_ENVIRONMENT=Production
# Loopback on purpose: front + backend live on the same Pi and the API must not face the LAN.
# If the UI ever runs on another machine, put a TLS reverse proxy in front instead of 0.0.0.0.
ASPNETCORE_URLS=http://127.0.0.1:5248

# PostgreSQL (local Docker, published on 127.0.0.1 only — see docker-compose.yml).
# install.sh generates the password and applies it to the running cluster via ALTER USER.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=reflowoven;Username=reflow;Password=CHANGE_ME

# HS256 signing key — ≥ 32 bytes enforced at boot. install.sh: openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME_32_BYTES_MINIMUM

# Seed/console credentials. NOTE: Admin/Regular/Master become DB rows on the FIRST seed of a fresh
# database — changing them here later does NOT rewrite existing rows (change those via the UI).
# The Technician is config-only (verified live against this value on every login).
Master__Password=CHANGE_ME
Admin__Password=CHANGE_ME
Regular__Password=CHANGE_ME
Technician__Password=CHANGE_ME

# Real OS control (nmcli/timedatectl/systemctl + /proc,/sys) and the front health probe.
System__Mode=Linux
System__FrontUrl=http://localhost:3000

# Power board link: keep Simulated until the RS422 wiring to the STM32 is validated, then Rs422.
Hardware__Mode=Simulated

# E-mail stays Stub unless SMTP is configured (Email__Mode=Smtp + Email__Smtp__* values).
Email__Mode=Stub
