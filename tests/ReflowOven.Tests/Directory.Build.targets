<Project>

  <!--
    Adds an EF Core provider to the test project so SystemServiceAuditTests can
    build a real ReflowDbContext for in-memory counting.

    We use the EF Core InMemory provider rather than SQLite: the production
    ReflowDbContext model emits PostgreSQL-specific DDL (e.g. a CHECK constraint
    using the `~` regex operator) that SQLite's DDL parser rejects at
    EnsureCreated time ("near \"~\": syntax error"). InMemory runs no DDL, and it
    honours the only model feature GetDatabaseAuditAsync depends on — the
    ReflowProgram soft-delete global query filter (verified via the
    IgnoreQueryFilters assertion). The owned-JSON columns are never read by the
    audit method, so InMemory's lack of jsonb support is irrelevant here.

    Version 10.0.8 matches the EF Core 10 line used by the other projects. The
    repo has no parent Directory.Build.targets, so nothing is shadowed; the root
    Directory.Build.props is still imported automatically by the SDK.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
  </ItemGroup>

</Project>
