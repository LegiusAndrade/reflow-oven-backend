# ----------------------------------------------------------------------------------------
# Reflow Oven backend — production environment template.
#
# Copy to `.env` (gitignored) on the device/server and fill in REAL secrets, OR export these
# as real environment variables in your service manager (systemd unit, container env, etc.).
# .NET maps the `Section__Key` env-var form onto `Section:Key` in configuration, so each var
# below overrides the matching dev placeholder in appsettings.json — NEVER commit real values.
#
# Program.cs FAILS FAST on startup outside Development if either of these is left on its
# dev placeholder:
#   - Jwt__SigningKey  == "dev-only-change-me-please-use-32-bytes-minimum!"
#   - Master__Password == "pandewilly"
# So a production boot is impossible until you set them here.
#
# Generate a strong value for any secret with:   openssl rand -base64 32
# ----------------------------------------------------------------------------------------

# Run outside Development so the fail-fast guards are active (Development skips them).
ASPNETCORE_ENVIRONMENT=Production

# --- Database -----------------------------------------------------------------------------
# Postgres connection string consumed by the API.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=reflowoven;Username=reflow;Password=CHANGE_ME

# --- JWT signing key (REQUIRED in production; >= 32 bytes) ---------------------------------
# openssl rand -base64 32
Jwt__SigningKey=CHANGE_ME_32_BYTES_MINIMUM

# --- Master superuser (dev/superuser; the only Master account) ----------------------------
# Username/Email may keep the defaults; the PASSWORD is a real secret and MUST be overridden.
# openssl rand -base64 24
Master__Username=dev.pandewilly
Master__Email=master@reflow.local
Master__Password=CHANGE_ME

# --- Calibration technician (hidden Calibração login) -------------------------------------
Technician__Username=calibracao
Technician__Password=CHANGE_ME

# --- Email (set Mode=Smtp in production so onboarding/reset/expiry emails actually send) ---
Email__Mode=Smtp
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__User=CHANGE_ME
Email__Smtp__Password=CHANGE_ME
Email__Smtp__From=CHANGE_ME
Email__Smtp__UseStartTls=true

# --- Hardware / platform (the OrangePi/Raspberry deployment) -------------------------------
# Hardware: Simulated (default) | Rs422        System: Simulated (default) | Linux
Hardware__Mode=Rs422
System__Mode=Linux

# --- CORS (the Next.js frontend origin) ---------------------------------------------------
Cors__Origins__0=https://your-frontend-host
