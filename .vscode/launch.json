{
  // F5 compila (preLaunchTask "build") e sobe a API com o debugger anexado.
  // Coloque breakpoints clicando na margem esquerda de qualquer arquivo .cs.
  //
  // ⚠️ O debugger parando em ValidationAppException / NotFoundException / ConflictException é ESPERADO e
  // benigno: essas AppException são fluxo de validação, capturadas pelo ExceptionMiddleware (viram 400/404/
  // 409 pro front), nunca crasham. Pra o debugger não te interromper nelas, no painel RUN AND DEBUG >
  // BREAKPOINTS, DESMARQUE "User-Unhandled Exceptions" ("Exceções Não Tratadas pelo Usuário"). É seguro:
  // o middleware é a rede de segurança global, então você ainda vê erros de verdade (que viram 500).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (.NET 10)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ReflowOven.Api/bin/Debug/net10.0/ReflowOven.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ReflowOven.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ROOT": "${env:HOME}/.dotnet",
        "PATH": "${env:HOME}/.dotnet:${env:HOME}/.dotnet/tools:${env:PATH}"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "console": "internalConsole"
    },
    {
      "name": "Attach to process (.NET)",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
